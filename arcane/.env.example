# Arcane project "security-center" environment.
# Create these values in the Project → Environment screen (not in git).

POSTGRES_USER=security
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=security_center

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=https://sechub.cloud.piradata.dev

# Host port published on the homelab. Nginx Proxy Manager forwards here.
APP_PORT=5377
