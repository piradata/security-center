# Local development values (compose.dev.yaml).
# `docker compose up` does not need this file; it generates AUTH_SECRET.

# Database
DATABASE_URL=postgresql://security:security@localhost:5432/security_center?schema=public

# Auth.js — generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Export file storage (app + worker)
STORAGE_PATH=./data/exports

# Base URL used in CI snippets
SC_URL=http://localhost:3000

# docker compose loads this file via env_file for the dev app + worker.
# Compose overrides DATABASE_URL (postgres hostname) and STORAGE_PATH.
