# Database
DATABASE_URL=postgresql://security:security@localhost:5432/security_center?schema=public

# Auth.js
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
# Optional: AUTH_TRUST_HOST=true behind proxies

# OIDC (required for login)
AUTH_OIDC_ISSUER=https://your-idp.example.com
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# First user with this email becomes admin (case-insensitive)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Export file storage (app + worker)
STORAGE_PATH=./data/exports
